AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=32
MAX_INDEX_CHUNKS=1500
RETRIEVAL_TOP_K=5
MAX_TOOL_ROUNDS=6
MAX_HISTORY_TURNS=6
OLLAMA_TIMEOUT_SECONDS=300

# Opções do Docker Compose (Linux e Ubuntu no WSL 2).
# Dentro do container, localhost aponta para o próprio container; use o host
# especial abaixo para acessar o Ollama executado no Windows ou no WSL.
CONTAINER_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
APP_HOST=127.0.0.1
APP_PORT=7860
REPOSITORY_PATH=.

# Para usar OpenAI, altere AI_PROVIDER e configure:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
